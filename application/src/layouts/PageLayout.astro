---
import Footer from '~/components/widgets/Footer.astro';
import Header from '~/components/widgets/Header.astro';
import AnnouncementBar from '~/components/widgets/AnnouncementBar.astro';
import { getAnnouncementContent } from '~/data/announcement';
import { getLangFromUrl } from '~/i18n/utils';
import Layout from '~/layouts/Layout.astro';

import { getLocalizedFooterData, getLocalizedHeaderData } from '~/navigation';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;

// Use localized navigation data
const lang = getLangFromUrl(Astro.url);
const localizedHeaderData = getLocalizedHeaderData(Astro.url);
const localizedFooterData = getLocalizedFooterData(Astro.url);
const announcement = getAnnouncementContent(lang);
---

<Layout metadata={metadata}>
  <AnnouncementBar {...announcement} />
  <slot name="header"> <Header {...localizedHeaderData} isSticky showRssFeed showToggleTheme /> </slot>
  <main><slot /></main>
  <slot name="footer"> <Footer {...localizedFooterData} /> </slot>
</Layout>
