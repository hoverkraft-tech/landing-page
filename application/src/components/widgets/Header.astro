---
import { Icon } from 'astro-icon/components';
import LanguageSelector from '~/components/common/LanguageSelector.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import Logo from '~/components/Logo.astro';
import Button from '~/components/ui/Button.astro';
import type { CallToAction } from '~/types';
import { getAsset, getHomePermalink, trimSlash } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  description?: string;
  featured?: {
    label: string;
    title: string;
    description: string;
    href: string;
    cta: string;
    icon?: string;
  };
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
  homeHref?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
  homeHref = getHomePermalink(),
} = Astro.props;

const normalizePath = (path: string): string => {
  if (!path) return '/';
  const noQueryHash = path.split(/[?#]/)[0] ?? path;
  const trimmed = trimSlash(noQueryHash);
  return trimmed ? `/${trimmed}` : '/';
};

const currentPath = normalizePath(new URL(Astro.url).pathname);
const externalLinkAttrs = (href?: string) =>
  href?.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-opacity ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-3 px-3 xl:px-6 mx-auto w-full',
      {
        'xl:flex xl:justify-between': position !== 'center',
      },
      {
        'xl:grid xl:grid-cols-[1fr_auto_1fr] xl:items-center xl:gap-x-4': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
      <a class="flex items-center" href={homeHref}> <Logo /> </a>
      <div class="flex items-center xl:hidden"><ToggleMenu /></div>
    </div>
    <nav
      class="items-center w-full xl:w-auto hidden xl:flex xl:mx-5 text-default overflow-y-auto overflow-x-hidden xl:overflow-visible xl:justify-self-center"
      aria-label="Main navigation"
    >
      <ul
        class="flex flex-col xl:flex-row xl:self-center w-full xl:w-auto text-xl xl:text-[0.9375rem] tracking-[0.01rem] font-medium xl:justify-center"
      >
        {links.map(({ text, href, links, featured }, index, arr) => (
          <li class={links?.length ? 'dropdown xl:relative' : ''}>
            {links?.length ? (
              <>
                <button
                  type="button"
                  class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                >
                  {text}{' '}
                  <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden xl:inline" />
                </button>
                <div
                  class:list={[
                    'dropdown-menu pl-4 xl:pl-0 xl:hidden xl:absolute xl:top-full xl:pt-3 xl:z-[60]',
                    index >= Math.ceil(arr.length / 2) ? 'xl:right-0' : 'xl:left-1/2 xl:-translate-x-1/2',
                    featured ? 'xl:w-[42rem]' : 'xl:w-[24rem]',
                  ]}
                >
                  <div class="xl:overflow-hidden xl:rounded-2xl xl:border xl:border-gray-200 xl:bg-white/95 xl:shadow-xl xl:backdrop-blur-md xl:dark:border-white/12 xl:dark:bg-slate-950/95 xl:dark:shadow-[0_24px_80px_rgba(0,0,0,0.55)]">
                    <div
                      class:list={[
                        'xl:grid xl:gap-0',
                        featured ? 'xl:grid-cols-[16rem_1fr] xl:dark:divide-x xl:dark:divide-white/8' : '',
                      ]}
                    >
                      {featured && (
                        <a
                          class="group hidden xl:flex xl:flex-col xl:justify-between xl:gap-4 xl:bg-gradient-to-br xl:from-primary/10 xl:to-primary/5 xl:p-5 xl:dark:from-white/6 xl:dark:via-primary/12 xl:dark:to-transparent"
                          href={featured.href}
                          {...externalLinkAttrs(featured.href)}
                        >
                          <div>
                            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white xl:dark:bg-primary/18 xl:dark:text-primary xl:dark:ring-1 xl:dark:ring-primary/25">
                              <Icon name={featured.icon ?? 'tabler:star'} class="h-5 w-5" aria-hidden="true" />
                            </span>
                            <p class="mt-4 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-primary">
                              {featured.label}
                            </p>
                            <p class="mt-1 text-base font-bold leading-snug text-heading xl:dark:text-white">
                              {featured.title}
                            </p>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted xl:dark:text-gray-300/85">
                              {featured.description}
                            </p>
                          </div>
                          <span class="inline-flex items-center gap-1 text-sm font-semibold text-primary xl:dark:text-primary/90">
                            {featured.cta}
                            <Icon
                              name="tabler:arrow-right"
                              class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
                              aria-hidden="true"
                            />
                          </span>
                        </a>
                      )}
                      <ul class="xl:grid xl:gap-1 xl:p-3 xl:dark:bg-slate-950/70">
                        {links.map(({ text: text2, href: href2, description, icon }) => (
                          <li>
                            <a
                              class:list={[
                                'group flex items-start gap-3 rounded-xl py-2 px-3 transition-colors xl:hover:bg-gray-50 xl:dark:hover:bg-white/8',
                                normalizePath(href2 ?? '') === currentPath
                                  ? 'bg-primary/6 xl:dark:bg-primary/12 xl:dark:ring-1 xl:dark:ring-primary/18'
                                  : '',
                              ]}
                              href={href2}
                              {...externalLinkAttrs(href2)}
                            >
                              {icon && (
                                <span class="hidden xl:inline-flex xl:mt-0.5 xl:h-8 xl:w-8 xl:shrink-0 xl:items-center xl:justify-center xl:rounded-lg xl:bg-primary/10 xl:text-primary xl:transition-colors xl:group-hover:bg-primary xl:group-hover:text-white xl:dark:bg-white/6 xl:dark:text-primary xl:dark:group-hover:bg-primary xl:dark:group-hover:text-white">
                                  <Icon name={icon} class="h-4 w-4" aria-hidden="true" />
                                </span>
                              )}
                              <span class="xl:flex xl:flex-col">
                                <span class="text-sm font-semibold text-heading group-hover:text-primary dark:text-white xl:dark:group-hover:text-primary/90">
                                  {text2}
                                </span>
                                {description && (
                                  <span class="hidden xl:block xl:text-xs xl:leading-relaxed xl:text-muted xl:dark:text-gray-300/75">
                                    {description}
                                  </span>
                                )}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </>
            ) : (
              <a
                class:list={[
                  'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                  {
                    'aw-link-active': normalizePath(href ?? '') === currentPath,
                  },
                ]}
                href={href}
                {...externalLinkAttrs(href)}
              >
                {text}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden xl:self-center xl:flex items-center xl:mb-0 fixed w-full xl:w-auto xl:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 xl:p-0 xl:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full xl:w-auto">
        <div class="flex">
          <LanguageSelector />
          {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 xl:w-5 xl:h-5 xl:inline-block" />}
          {showRssFeed && (
            <a
              class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-hidden focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
              aria-label="RSS Feed"
              href={getAsset('/rss.xml')}
            >
              <Icon name="tabler:rss" class="w-5 h-5" />
            </a>
          )}
        </div>
        {actions?.length ? (
          <span class="ml-4 rtl:ml-0 rtl:mr-4">
            {actions.map((btnProps) => (
              <Button {...btnProps} class="ml-2 py-2.5 px-5.5 xl:px-6 font-semibold shadow-none text-sm w-auto" />
            ))}
          </span>
        ) : (
          ''
        )}
      </div>
    </div>
  </div>
</header>
