---
import { Icon } from 'astro-icon/components';
import logo from '~/assets/images/brand/logo/logo-icon.svg';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import type { PartnersPageContent } from '~/types/partners';

export interface Props {
  content: PartnersPageContent;
}
const { hero, catalog, labels } = Astro.props.content;
---

<section class="ecosystem-hero ecosystem-container" aria-labelledby="ecosystem-title">
  <div class="ecosystem-hero-copy">
    <p class="ecosystem-eyebrow">{hero.tagline}</p>
    <h1 id="ecosystem-title">{hero.title}<span>{hero.accentTitle}</span></h1>
    <p class="ecosystem-lead">{hero.subtitle}</p>
    <div class="ecosystem-actions">
      <Button {...hero.primaryAction} class="ecosystem-primary" icon="tabler:arrow-right" />
      <Button {...hero.secondaryAction} variant="link" class="ecosystem-text-action" icon="tabler:arrow-up-right" />
    </div>
    <p class="ecosystem-reassurance"><Icon name="tabler:lock-open" />{hero.reassurance}</p>
  </div>
  <div class="ecosystem-diagram" aria-label={hero.diagramLabel}>
    <p class="ecosystem-diagram-kicker">{hero.diagramKicker}<span aria-hidden="true">+</span></p>
    <div class="ecosystem-map">
      <svg class="ecosystem-connections" viewBox="0 0 600 360" fill="none" aria-hidden="true">
        <path d="M180 92H220Q242 92 242 114V156H298M379 195H405Q427 195 427 218V270H470" />
        <path class="ecosystem-connection-ownership" d="M300 230V298Q300 322 276 322H80" />
        <circle cx="241" cy="156" r="4" />
        <circle cx="427" cy="270" r="4" />
        <circle class="ecosystem-ownership-dot" cx="250" cy="322" r="4" />
      </svg>
      <a class="ecosystem-node ecosystem-node-partners" data-browse="partners" href="#catalog-panel-partners">
        <Icon name="tabler:users" class="ecosystem-node-icon" />
        <strong>{labels.collections.partners}</strong>
        <span>{hero.partnerAction}</span>
        <small class="ecosystem-node-count">{catalog.partners.length}</small>
      </a>
      <a class="ecosystem-node ecosystem-node-hoverkraft" href="#ecosystem-freedom">
        <Image src={logo} alt="" width={54} height={54} loading="eager" />
        <strong>Hoverkraft</strong><span>{hero.hoverkraftAction}</span>
      </a>
      <a class="ecosystem-node ecosystem-node-credentials" data-browse="credentials" href="#catalog-panel-credentials">
        <Icon name="tabler:rosette-discount-check" class="ecosystem-node-icon" />
        <strong>{labels.collections.credentials}</strong>
        <span>{hero.credentialAction}</span>
        <small class="ecosystem-node-count">{catalog.credentials.length}</small>
      </a>
      <p class="ecosystem-ownership"><Icon name="tabler:users" />{hero.ownership}</p>
    </div>
    <div class="ecosystem-diagram-caption">
      <Icon name="tabler:lock-open" />
      <p><strong>{hero.captionTitle}</strong><span>{hero.caption}</span></p>
    </div>
  </div>
</section>
