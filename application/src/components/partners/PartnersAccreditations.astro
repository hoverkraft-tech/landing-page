---
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { PartnersAccreditation, PartnersSectionHeader } from './types';

export interface Props {
  header: PartnersSectionHeader;
  items: PartnersAccreditation[];
}

const { header, items } = Astro.props;

const featured = items.find((item) => item.featured);
const supporting = items.filter((item) => item !== featured);
---

<WidgetWrapper id="accreditations" containerClass="py-16 md:py-20 lg:py-24">
  <Headline
    {...header}
    classes={{
      container: 'max-w-3xl md:mx-auto text-center',
      title: 'text-3xl md:text-4xl font-bold tracking-tight',
      subtitle: 'text-base md:text-lg leading-relaxed',
    }}
  />

  <div class="grid gap-5">
    {featured && (
      <article class="relative overflow-hidden rounded-2xl border border-primary/30 bg-primary/5 p-6 dark:bg-primary/10 md:p-8">
        <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-primary/10 blur-3xl" aria-hidden="true" />
        <div class="relative grid gap-6 md:grid-cols-[auto_1fr] md:items-center">
          <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary text-white shadow-lg">
            <Icon name={featured.icon ?? 'tabler:rosette-discount-check'} class="h-8 w-8" aria-hidden="true" />
          </div>
          <div>
            <h3 class="text-2xl font-semibold text-heading">{featured.title}</h3>
            <p class="mt-2 max-w-3xl text-base leading-relaxed text-default">{featured.description}</p>
            <div class="mt-5 flex flex-wrap items-center gap-3">
              {featured.badges.map((badge) =>
                badge.href ? (
                  <a
                    href={badge.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-white transition-colors hover:bg-primary/90"
                  >
                    {badge.text}
                    <Icon name="tabler:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
                  </a>
                ) : (
                  <span class="inline-flex items-center rounded-full bg-primary/15 px-3 py-1 text-xs font-semibold text-primary">
                    {badge.text}
                  </span>
                )
              )}
              {featured.link && (
                <a
                  href={featured.link.href}
                  class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
                >
                  {featured.link.text}
                  <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
                </a>
              )}
            </div>
          </div>
        </div>
      </article>
    )}

    <div class="grid gap-5 md:grid-cols-3">
      {supporting.map((item) => (
        <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/4">
          <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <Icon name={item.icon ?? 'tabler:circle'} class="h-6 w-6" aria-hidden="true" />
          </div>
          <h3 class="text-lg font-semibold text-heading">{item.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{item.description}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {item.badges.map((badge) =>
              badge.href ? (
                <a
                  href={badge.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-full border border-primary/30 px-3 py-1 text-xs font-semibold text-primary transition-colors hover:bg-primary/10"
                >
                  {badge.text}
                  <Icon name="tabler:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
                </a>
              ) : (
                <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-default dark:bg-white/10">
                  {badge.text}
                </span>
              )
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</WidgetWrapper>
