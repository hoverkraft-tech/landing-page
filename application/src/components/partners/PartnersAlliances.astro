---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { PartnersAlliance, PartnersSectionHeader, PartnersSynergy } from './types';

export interface Props {
  header: PartnersSectionHeader;
  items: PartnersAlliance[];
  synergy: PartnersSynergy;
}

const { header, items, synergy } = Astro.props;
---

<WidgetWrapper id="commercial" containerClass="py-16 md:py-20 lg:py-24">
  <Headline
    {...header}
    classes={{
      container: 'max-w-3xl md:mx-auto text-center',
      title: 'text-3xl md:text-4xl font-bold tracking-tight',
      subtitle: 'text-base md:text-lg leading-relaxed',
    }}
  />

  <div class="grid gap-5">
    {items.map((item) => (
      <article class="grid gap-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/4 md:grid-cols-[0.8fr_1.2fr] md:items-center md:p-8">
        <div class="flex flex-col items-start gap-4 md:border-r md:border-gray-200 md:pr-8 md:dark:border-white/10">
          {item.logo ? (
            <span
              class="inline-flex items-center [&_svg]:block [&_svg]:h-9 [&_svg]:w-auto"
              aria-hidden="true"
              set:html={item.logo.svg}
            />
          ) : (
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary">
              <Icon name={item.icon ?? 'tabler:building'} class="h-7 w-7" aria-hidden="true" />
            </span>
          )}
          <div>
            <h3 class:list={['text-2xl font-bold text-heading', item.logo && 'sr-only']}>{item.name}</h3>
            <p class="mt-1 text-xs font-semibold uppercase tracking-[0.18em] text-secondary">{item.tagline}</p>
          </div>
          <p class="text-sm leading-relaxed text-muted">{item.description}</p>
        </div>

        <div>
          <ul class="grid gap-3 sm:grid-cols-2">
            {item.highlights.map((highlight) => (
              <li class="flex items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm font-medium text-default dark:border-white/10 dark:bg-white/5">
                <Icon
                  name={highlight.icon ?? 'tabler:check'}
                  class="h-5 w-5 shrink-0 text-primary"
                  aria-hidden="true"
                />
                <span>{highlight.text}</span>
              </li>
            ))}
          </ul>
          {item.action && (
            <div class="mt-6">
              <Button {...item.action} class="w-full sm:w-auto" />
            </div>
          )}
        </div>
      </article>
    ))}

    <article class="rounded-2xl border border-gray-200 bg-gray-50 p-6 dark:border-white/10 dark:bg-slate-950/40 md:p-8">
      <div class="mx-auto max-w-2xl text-center">
        <h3 class="text-xl font-semibold text-heading md:text-2xl">{synergy.title}</h3>
        {synergy.subtitle && <p class="mt-2 text-sm leading-relaxed text-muted md:text-base">{synergy.subtitle}</p>}
      </div>

      <div class="mt-8 flex flex-col items-stretch gap-4 lg:flex-row lg:items-center lg:justify-center">
        {[synergy.hoverkraft, synergy.partner].map((actor, index) => (
          <Fragment>
            {index === 1 && (
              <span
                class="mx-auto inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary"
                aria-hidden="true"
              >
                <Icon name="tabler:plus" class="h-5 w-5" />
              </span>
            )}
            <div class="flex flex-1 items-center gap-4 rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-white/5 lg:max-w-xs">
              <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-secondary/10 text-secondary">
                <Icon name={actor.icon ?? 'tabler:circle'} class="h-6 w-6" aria-hidden="true" />
              </span>
              <div>
                <p class="text-sm font-bold text-heading">{actor.label}</p>
                <p class="mt-0.5 text-sm leading-snug text-muted">{actor.text}</p>
              </div>
            </div>
          </Fragment>
        ))}

        <span
          class="mx-auto inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-white lg:mx-0"
          aria-hidden="true"
        >
          <Icon name="tabler:equal" class="h-5 w-5" />
        </span>

        <div
          class="flex flex-1 items-center gap-3 rounded-xl border border-primary/30 bg-primary/5 p-5 text-left dark:bg-primary/10 lg:max-w-xs"
        >
          <Icon name="tabler:rocket" class="h-6 w-6 shrink-0 text-primary" aria-hidden="true" />
          <p class="text-sm font-semibold leading-snug text-heading">{synergy.result}</p>
        </div>
      </div>
    </article>
  </div>
</WidgetWrapper>
