{
  "name": "generate-brand-content",
  "version": "1.0.0",
  "private": true,
  "description": "Generates TypeScript files for brand colors, mission, typography, and logos",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "test:ci": "node --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"${CI_REPORTS_DIR:-.reports}/junit.xml\" --test-reporter=lcov --test-reporter-destination=\"${CI_REPORTS_DIR:-.reports}/coverage/lcov.info\" --test",
    "pretest:ci": "node -e \"require('node:fs').mkdirSync((process.env.CI_REPORTS_DIR || '.reports') + '/coverage', {recursive:true})\""
  }
}
